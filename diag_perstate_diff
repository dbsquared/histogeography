"""
diag_perstate_diff.py — 分析逐州参考图与总览图的区别
判断：逐州图是"目标州高亮+其他州灰化"，还是"全图同色"？
"""
import os, numpy as np
from PIL import Image

WORK = r'E:\projects\3D地图制作'
REF = os.path.join(WORK, '汉末十三州地图范例')
OVERVIEW = os.path.join(REF, '全览-郡级.png')
STATES = ['凉州','益州','司隶','并州','冀州','青州','幽州',
          '兖州','豫州','徐州','扬州','荆州','交州']

ov = np.asarray(Image.open(OVERVIEW).convert('RGB')).astype(np.int32)
H, W = ov.shape[:2]
print(f'Overview {W}x{H}')

# 与总览图完全相同？
identical = 0
diffstats = []
for name in STATES:
    p = os.path.join(REF, f'{name}.png')
    if not os.path.exists(p):
        print(f'  {name}: 文件缺失'); continue
    img = np.asarray(Image.open(p).convert('RGB')).astype(np.int32)
    if img.shape != (H, W, 3):
        print(f'  {name}: 尺寸不同 {img.shape} vs {ov.shape}'); continue
    diff = np.abs(img - ov).sum(axis=2)
    md = diff.max(); mean_d = diff.mean(); nonzero = (diff > 30).sum()
    frac = nonzero / (H * W)
    if md == 0:
        identical += 1
        print(f'  {name}: 与总览图完全相同 (identical)')
    else:
        diffstats.append((name, md, mean_d, frac))
        print(f'  {name}: maxΔ={md:4d} meanΔ={mean_d:6.1f} 差异像素占比={frac*100:4.1f}%')

print(f'\n与总览完全相同的州数: {identical}/{len(STATES)}')

if diffstats:
    print('\n=== 有差异的州（按差异像素占比排序）===')
    diffstats.sort(key=lambda x: -x[3])
    for name, md, mean_d, frac in diffstats:
        print(f'  {name:7s} maxΔ={md:4d} meanΔ={mean_d:7.1f} 差异占比={frac*100:5.2f}%')
